#!/bin/bash

# 专业日志分析专家 - 统一入口脚本
# 整合SSH远程日志分析和ELK集中式日志分析功能

set -e

# 基础配置
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
