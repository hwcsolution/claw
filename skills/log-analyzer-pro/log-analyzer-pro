}

# 检查依赖
check_dependencies() {
    local missing_deps=()
    
    # 检查基本命令
    for cmd in curl jq ssh; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing_deps+=("$cmd")
        fi
    done
    
    # 检查Python
    if ! command -v python3 >/dev/null 2>&1; then
        missing_deps+=("python3")
    fi
    
    if [ ${#missing_deps[@]} -gt 0 ]; then
        log_error "缺少依赖: ${missing_deps[*]}"
        echo "请安装缺少的依赖:"
        echo "  Ubuntu/Debian: sudo apt-get install ${missing_deps[*]}"
        echo "  CentOS/RHEL: sudo yum install ${missing_deps[*]}"
        echo "  macOS: brew install ${missing_deps[*]}"
        return 1
    fi
    
    return 0
}

# 初始化环境
init_environment() {
    # 创建必要的目录
    mkdir -p "$CONFIG_DIR" "$KNOWLEDGE_BASE" "$SCRIPTS_DIR" "$TOOLS_DIR" "$LOGS_DIR" "$REPORTS_DIR"
    
    # 设置日志文件
    local timestamp=$(date +%Y%m%d_%H%M%S)
    LOG_FILE="$LOGS_DIR/log-analyzer-pro_${timestamp}.log"
    
    # 记录启动信息
    log_info "启动 log-analyzer-pro"
    log_info "脚本目录: $SCRIPT_DIR"
    log_info "配置目录: $CONFIG_DIR"
    log_info "知识库目录: $KNOWLEDGE_BASE"
    log_info "日志文件: $LOG_FILE"
}

