# 主函数
main() {
    # 检查参数
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi
    
    # 处理全局选项
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --verbose|-v)
                export LOG_LEVEL="DEBUG"
                shift
                ;;
            --quiet|-q)
                export LOG_LEVEL="ERROR"
                shift
                ;;
            --debug)
                export DEBUG_MODE="true"
                set -x
                shift
                ;;
            --version)
                show_version
                exit 0
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done
    
    # 获取主命令
    local command="$1"
    shift
    
    # 初始化环境
    init_environment
    
    # 检查依赖
    if ! check_dependencies; then
        exit 1
    fi
    
    # 根据命令路由到对应的处理函数
    case "$command" in
        "ssh")
            handle_ssh "$@"
            ;;
        "elk")
            handle_elk "$@"
            ;;
        "analyze")
            handle_analyze "$@"
            ;;
        "knowledge")
            handle_knowledge "$@"
            ;;
        "config")
            handle_config "$@"
            ;;
        "report")
            handle_report "$@"
            ;;
        "alert")
            handle_alert "$@"
            ;;
        "workflow")
            handle_workflow "$@"
            ;;
        "tools")
            handle_tools "$@"
            ;;
        "help")
            show_help
            ;;
        *)
            log_error "未知命令: $command"
            show_help
            exit 1
            ;;
    esac
}

# 执行主函数
main "$@"

