            python3 "$SCRIPTS_DIR/ssh_log_fetcher.py" "$@"
            ;;
        "analyze")
            # SSH日志分析
            log_info "执行SSH日志分析"
            python3 "$SCRIPTS_DIR/log_analyzer.py" --source ssh "$@"
            ;;
        "monitor")
            # SSH日志监控
            log_info "执行SSH日志监控"
            python3 "$SCRIPTS_DIR/ssh_monitor.py" "$@"
            ;;
        "batch")
            # SSH批量操作
            log_info "执行SSH批量操作"
            python3 "$SCRIPTS_DIR/ssh_batch.py" "$@"
            ;;
        "test")
            # SSH连接测试
            log_info "测试SSH连接"
            python3 "$SCRIPTS_DIR/ssh_tester.py" "$@"
            ;;
        "config")
